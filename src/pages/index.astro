---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import homeShot from '../assets/screenshots/home.png';
import tripShot from '../assets/screenshots/trip.png';
import galleryShot from '../assets/screenshots/gallery.png';
import editorShot from '../assets/screenshots/post-editor.png';

const repoUrl = 'https://github.com/Backroads4Me/postmarked';
const installUrl = 'https://github.com/Backroads4Me/postmarked#install';
const demoUrl = 'https://werehere.app';
const newTabAttrs = { target: '_blank', rel: 'noopener noreferrer' };
---

<Layout>
  <header class="top-nav">
    <div class="frame top-nav-inner">
      <a href="/" class="brand" aria-label="Postmarked home">
        <img src="/favicon.svg" alt="" width="28" height="28" aria-hidden="true" />
        <span>Postmarked</span>
      </a>
      <nav class="nav-actions" aria-label="Primary">
        <a class="nav-link" href="#features">Features</a>
        <a class="nav-link" href="#self-host">Self-host</a>
        <a class="nav-link" href={demoUrl} {...newTabAttrs}>Demo</a>
        <button
          type="button"
          class="theme-toggle"
          data-theme-toggle
          aria-label="Toggle color theme"
          title="Toggle light and dark theme"
        >
          <svg class="theme-icon theme-icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>
          <svg class="theme-icon theme-icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
        </button>
        <a class="btn-primary" href={repoUrl} {...newTabAttrs}>GitHub</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="frame hero-grid">
        <div class="hero-copy">
          <h1 class="display">Digital postcards from the road.</h1>
          <p class="lede">
            Postmarked is a self-hosted way to share trip pages, photos, videos, and updates with the people you choose.
          </p>
          <div class="cta-row">
            <a class="btn-primary" href={repoUrl} {...newTabAttrs}>View on GitHub</a>
            <a class="btn" href={demoUrl} {...newTabAttrs}>Demo</a>
          </div>
        </div>
        <div class="screenshot-frame hero-shot">
          <Image
            src={homeShot}
            alt="Postmarked home page showing recent travel updates and media"
            widths={[640, 960, 1280]}
            sizes="(max-width: 767px) 100vw, 52vw"
            format="webp"
            quality={82}
            loading="eager"
          />
        </div>
      </div>
    </section>

    <section class="section-tight" id="features">
      <div class="frame">
        <div class="section-head">
          <p class="eyebrow">Why Postmarked</p>
          <h2 class="display">A quieter place for the trip.</h2>
        </div>
        <div class="features-grid">
          <article class="card feature-card">
            <span class="label">Privacy first</span>
            <h3 class="display">Share with family, not a feed.</h3>
            <p>Public and private visibility controls keep each trip update as open or closed as it needs to be.</p>
          </article>
          <article class="card feature-card">
            <span class="label">Your data</span>
            <h3 class="display">Self-hosted and open source.</h3>
            <p>Run Postmarked yourself, keep your media under your control, and skip ads, tracking, and social churn.</p>
          </article>
          <article class="card feature-card">
            <span class="label">Trip journal</span>
            <h3 class="display">Posts, photos, and videos.</h3>
            <p>Build trip pages with a timeline of stops, updates, galleries, and the context people need to follow along.</p>
          </article>
          <article class="card feature-card">
            <span class="label">Made to run</span>
            <h3 class="display">Admin tools included.</h3>
            <p>Manage trips, stops, posts, media, users, site text, settings, backups, and RV Trip Wizard imports.</p>
          </article>
          <article class="card feature-card">
            <span class="label">Stay in touch</span>
            <h3 class="display">Email when you post.</h3>
            <p>Subscribers get a notification for each new update, so family follows along without an app, account, or algorithm.</p>
          </article>
          <article class="card feature-card">
            <span class="label">Yours to keep</span>
            <h3 class="display">Backups and migration.</h3>
            <p>Automatic database snapshots for disaster recovery, plus a one-click export to move a small instance between machines.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="frame showcase">
        <div class="showcase-row">
          <div class="showcase-copy">
            <p class="eyebrow">Trip pages</p>
            <h3 class="display">Each journey gets a home.</h3>
            <p>Trip pages collect stops, dates, locations, posts, photos, and videos into one readable route for friends and family.</p>
          </div>
          <div class="screenshot-frame">
            <Image
              src={tripShot}
              alt="Postmarked trip page with route details, stops, and travel posts"
              widths={[640, 960, 1280]}
              sizes="(max-width: 767px) 100vw, 52vw"
              format="webp"
              quality={82}
              loading="lazy"
            />
          </div>
        </div>

        <div class="showcase-row">
          <div class="showcase-copy">
            <p class="eyebrow">Media galleries</p>
            <h3 class="display">Photos and videos sit with the story.</h3>
            <p>Galleries keep trip media close to the update it belongs to, so people can see the place without digging through a stream.</p>
          </div>
          <div class="screenshot-frame">
            <Image
              src={galleryShot}
              alt="Postmarked media gallery showing travel photos and videos"
              widths={[640, 960, 1280]}
              sizes="(max-width: 767px) 100vw, 52vw"
              format="webp"
              quality={82}
              loading="lazy"
            />
          </div>
        </div>

        <div class="showcase-row">
          <div class="showcase-copy">
            <p class="eyebrow">Admin UI</p>
            <h3 class="display">Simple publishing from camp or home.</h3>
            <p>Create posts, attach media, edit site text, manage users, and import RV Trip Wizard spreadsheets from the full admin surface.</p>
          </div>
          <div class="screenshot-frame">
            <Image
              src={editorShot}
              alt="Postmarked admin post editor with fields for title, body, visibility, and media"
              widths={[640, 960, 1280]}
              sizes="(max-width: 767px) 100vw, 52vw"
              format="webp"
              quality={82}
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="section-tight self-host" id="self-host">
      <div class="frame">
        <div class="card-flat">
          <p class="eyebrow">Self-host</p>
          <h2 class="display">Docker compose, then go.</h2>
          <p>
            Download the compose file and example environment, edit production values, then start the stack.
          </p>
          <pre class="code-block" tabindex="0"><code>curl -fLO https://raw.githubusercontent.com/Backroads4Me/postmarked/main/compose.yaml
curl -fLo .env https://raw.githubusercontent.com/Backroads4Me/postmarked/main/.env.example
docker compose up -d</code></pre>
          <p>
            <a class="inline-link" href={installUrl} {...newTabAttrs}>Full install instructions on GitHub</a>
          </p>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="frame footer-grid">
      <div class="footer-brand">
        <a href="/" class="brand" aria-label="Postmarked home">
          <img src="/favicon.svg" alt="" width="24" height="24" aria-hidden="true" />
          <span>Postmarked</span>
        </a>
        <p class="text-muted">Self-hosted digital postcards from the road. Free and open source under the <a class="inline-link" href="https://github.com/Backroads4Me/postmarked/blob/main/LICENSE" {...newTabAttrs}>AGPL v3</a>.</p>
      </div>
      <nav class="footer-links" aria-label="Footer">
        <a href={repoUrl} {...newTabAttrs}>GitHub</a>
        <a href={installUrl} {...newTabAttrs}>Install</a>
        <a href={demoUrl} {...newTabAttrs}>Live demo</a>
        <a href="https://github.com/sponsors/Backroads4Me" {...newTabAttrs}>Sponsor</a>
        <a href="#features">Features</a>
      </nav>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const storageKey = 'postmarked-theme';
      const root = document.documentElement;
      const media = window.matchMedia('(prefers-color-scheme: dark)');
      const themeColor = document.querySelector('meta[name="theme-color"]');

      const storedTheme = () => {
        const value = localStorage.getItem(storageKey);
        return value === 'light' || value === 'dark' ? value : null;
      };
      const resolveTheme = () => storedTheme() || (media.matches ? 'dark' : 'light');

      const applyTheme = (theme, preference) => {
        root.dataset.theme = theme;
        root.dataset.themePreference = preference || storedTheme() || 'system';
        if (themeColor) themeColor.setAttribute('content', theme === 'dark' ? '#0D141C' : '#E1D7BE');
        document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
          const next = theme === 'dark' ? 'light' : 'dark';
          button.setAttribute('aria-label', `Use ${next} theme`);
          button.setAttribute('title', `Use ${next} theme`);
        });
      };

      const syncTheme = () => applyTheme(resolveTheme());

      document.addEventListener('click', (event) => {
        const button = event.target.closest('[data-theme-toggle]');
        if (!button) return;
        const next = resolveTheme() === 'dark' ? 'light' : 'dark';
        localStorage.setItem(storageKey, next);
        applyTheme(next, next);
      });

      // Follow the OS live as long as the visitor hasn't made an explicit choice.
      media.addEventListener('change', () => {
        if (!storedTheme()) syncTheme();
      });

      syncTheme();
    })();
  </script>
</Layout>
